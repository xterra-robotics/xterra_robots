<?xml version="1.0" encoding="utf-8"?>
<!-- DHAV 1.3 legged (dhav1).  Rebuilt 2026-09-03 from the SolidWorks export
     "XTR_Dummy_DHAV_1.3_L_1" (SW2URDF 1.6.0-4-g7f85cfe, exported 2026-08-27),
     the material-assigned original dhav1 CAD export, and dhav1w v1.3.

     That Aug-27 legged export carries NO material assignment - every part comes
     out at 1000 kg/m^3 - so its masses and inertia MAGNITUDES are discarded.
     Its COMs, joint frames and inertia SIGNS are correct and are used.
     See ../NOTES.md for every deviation and the evidence behind it. -->
<robot name="dhav1">
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="false"/>
  </mujoco>
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="purple">
    <color rgba="0.541 0.337 0.722 1.0"/>
  </material>
  <material name="aluminium">
    <color rgba="0.8 0.8 0.82 1.0"/>
  </material>

  <!-- Base link -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 -0.011647" rpy="0 0 0"/>
      <mass value="7.87906075"/>
      <inertia ixx="0.03603948" ixy="-0.00013803" ixz="-0.00007439" iyy="0.09487694" iyz="0.00002758" izz="0.11626709"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dhav1_description/meshes/torso.STL"/>
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3062 0.20 0.10"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.12 0.07 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.05"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.12 -0.07 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.05"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.12 0.07 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.05"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.12 -0.07 -0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU link -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== FL leg ===================== -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="FL_hip_link"/>
    <origin xyz="0.2235 0.0535 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8378" upper="0.8378" effort="40" velocity="6.8"/>
  </joint>
  <link name="FL_hip_link">
    <inertial>
      <origin xyz="-0.0057414 0.0030508 0" rpy="0 0 0"/>
